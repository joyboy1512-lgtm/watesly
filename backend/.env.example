# DEVELOPMENT DEFAULTS ONLY. Rotate all secrets before production.
APP_NAME=Watesly
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=watesly_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
INVITATION_TOKEN_EXPIRE_HOURS=72
APP_PUBLIC_URL=http://localhost:5173

# Transactional email (team invitations). Leave SMTP_HOST empty to disable email sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Watesly
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

DATABASE_URL=postgresql+asyncpg://mywat:mywat@db:5432/mywat
POSTGRES_DB=mywat
POSTGRES_USER=mywat
POSTGRES_PASSWORD=mywat

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

CREDENTIAL_ENCRYPTION_KEY=generate-with-python-scripts-generate_dev_secrets.py
META_APP_SECRET=replace-with-meta-app-secret
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-private-random-token
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0

CORS_ORIGINS=http://localhost:5173

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=mywat
S3_SECRET_KEY=mywat-secret
S3_BUCKET=mywat-files
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/mywat-files
MINIO_ROOT_USER=mywat
MINIO_ROOT_PASSWORD=mywat-secret

# Separate key used to wrap per-account data encryption keys.
DATA_KEY_ENCRYPTION_KEY=generate-with-python-scripts-generate_dev_secrets.py
SUPPORT_ACCESS_MAX_HOURS=24

# --- Production overrides (copy to .env on server) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_PUBLIC_URL=https://www.watesly.com
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_DOMAIN=.your-domain.com
# CORS_ORIGINS=https://app.your-domain.com
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM_EMAIL=invites@watesly.com
# SMTP_FROM_NAME=Watesly
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com/mywat-files
# Meta webhook callback (configure in Meta Developer Console):
#   https://api.your-domain.com/api/v1/whatsapp/webhook
# Frontend build args (compose.prod.yaml / frontend Dockerfile):
#   VITE_API_BASE_URL=https://api.your-domain.com/api/v1
#   VITE_WS_BASE_URL=wss://api.your-domain.com/api/v1
